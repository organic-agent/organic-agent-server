// 앱 EC2에서 사이드카로 도는 Grafana Alloy의 설정. 앱이 /var/log/spring에 레벨별로 남긴 파일을
// tail 해 모니터링 서버의 Loki로 민다. CD가 docker-compose.prod.yml과 함께 EC2에 배포한다.
//
// level 라벨은 줄을 파싱하지 않고 파일 경로로 정한다 — logback의 LevelFilter가 파일마다 한 레벨만
// 쓰도록 보장하므로 경로가 곧 레벨이다. 줄 안의 traceId 같은 값은 Loki 쿼리에서 `| logfmt`로 꺼낸다.

logging {
	level  = "info"
	format = "logfmt"
}

local.file_match "spring" {
	path_targets = [
		{__path__ = "/var/log/spring/info/*.log", level = "info"},
		{__path__ = "/var/log/spring/warn/*.log", level = "warn"},
		{__path__ = "/var/log/spring/error/*.log", level = "error"},
	]
}

loki.source.file "spring" {
	targets    = local.file_match.spring.targets
	forward_to = [loki.process.spring.receiver]
}

loki.process "spring" {
	forward_to = [loki.write.loki.receiver]

	stage.static_labels {
		values = {
			service = "wes",
			env     = "prod",
		}
	}
}

loki.write "loki" {
	endpoint {
		// 모니터링 EC2의 VPC 내부 주소. compose가 Parameter Store(/wes/prod/monitoring.loki-url)에서 받아 넘긴다.
		url        = sys.env("LOKI_URL")
		batch_wait = "1s"
		batch_size = "1MiB"
	}
}
