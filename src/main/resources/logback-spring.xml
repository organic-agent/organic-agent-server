<?xml version="1.0" encoding="UTF-8"?>
<!--
  로그 출력 규칙. 레벨은 여기가 아니라 config/application-variable.yml의 logging.level이 정한다.

  포맷은 logfmt(key=value)다 — Loki에서 `| logfmt`로 파싱해 traceId·level로 바로 거를 수 있다.
  traceId는 HttpLoggingFilter가 요청마다 MDC에 심는 값이라, 한 요청이 남긴 모든 줄을 한 번에 모을 수 있다.
  스케줄러처럼 요청 밖에서 찍히는 줄은 traceId=null이 된다.
-->
<configuration scan="true" scanPeriod="60 seconds">
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
  <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

  <property name="LOG_PATTERN"
    value="timestamp=%d{yyyy-MM-dd'T'HH:mm:ss,Asia/Seoul} level=%-5level traceId=%X{traceId:-null} logger=%logger{36} %msg%n%ex"/>

  <!--
    prod: 레벨별 파일로 나눠 쓴다. 컨테이너의 /var/log/spring은 호스트 디렉터리(docker-compose.prod.yml의
    ./logs)라 앱이 재시작해도 남고, 같은 디렉터리를 Alloy 사이드카가 tail 해 Loki로 보낸다.
    파일별 필터가 자기 레벨만 ACCEPT하므로 한 줄이 두 파일에 겹쳐 들어가지 않는다 — Alloy가 파일 경로로
    level 라벨을 붙이는 전제가 이것이다.
  -->
  <springProfile name="prod">
    <!-- 시스템 프로퍼티·환경변수 LOG_PATH로 바꿀 수 있다. 컨테이너 밖에서 prod 로그 출력을 확인할 때 쓴다. -->
    <property name="LOG_PATH" value="${LOG_PATH:-/var/log/spring}"/>
    <!-- 보관 기간. Loki가 장기 보관을 맡으므로 파일은 Alloy가 따라잡을 여유만 있으면 된다. -->
    <property name="MAX_HISTORY" value="7"/>
    <!-- 앱 EC2 루트 볼륨이 20GB라 파일마다 상한을 둔다. 넘으면 오래된 날짜부터 지운다. -->
    <property name="TOTAL_SIZE_CAP" value="300MB"/>

    <appender name="INFO_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
      <file>${LOG_PATH}/info/info.log</file>
      <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
        <fileNamePattern>${LOG_PATH}/info/info.%d{yyyy-MM-dd}.log</fileNamePattern>
        <maxHistory>${MAX_HISTORY}</maxHistory>
        <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
      </rollingPolicy>
      <encoder>
        <pattern>${LOG_PATTERN}</pattern>
      </encoder>
      <filter class="ch.qos.logback.classic.filter.LevelFilter">
        <level>INFO</level>
        <onMatch>ACCEPT</onMatch>
        <onMismatch>DENY</onMismatch>
      </filter>
    </appender>

    <appender name="WARN_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
      <file>${LOG_PATH}/warn/warn.log</file>
      <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
        <fileNamePattern>${LOG_PATH}/warn/warn.%d{yyyy-MM-dd}.log</fileNamePattern>
        <maxHistory>${MAX_HISTORY}</maxHistory>
        <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
      </rollingPolicy>
      <encoder>
        <pattern>${LOG_PATTERN}</pattern>
      </encoder>
      <filter class="ch.qos.logback.classic.filter.LevelFilter">
        <level>WARN</level>
        <onMatch>ACCEPT</onMatch>
        <onMismatch>DENY</onMismatch>
      </filter>
    </appender>

    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
      <file>${LOG_PATH}/error/error.log</file>
      <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
        <fileNamePattern>${LOG_PATH}/error/error.%d{yyyy-MM-dd}.log</fileNamePattern>
        <maxHistory>${MAX_HISTORY}</maxHistory>
        <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
      </rollingPolicy>
      <encoder>
        <pattern>${LOG_PATTERN}</pattern>
      </encoder>
      <filter class="ch.qos.logback.classic.filter.LevelFilter">
        <level>ERROR</level>
        <onMatch>ACCEPT</onMatch>
        <onMismatch>DENY</onMismatch>
      </filter>
    </appender>

    <root level="INFO">
      <appender-ref ref="CONSOLE"/>
      <appender-ref ref="INFO_FILE"/>
      <appender-ref ref="WARN_FILE"/>
      <appender-ref ref="ERROR_FILE"/>
    </root>
  </springProfile>

  <!-- local·test: 콘솔만. 파일을 남기면 개발 머신과 CI에 /var/log/spring 쓰기 권한이 필요해진다. -->
  <springProfile name="!prod">
    <root level="INFO">
      <appender-ref ref="CONSOLE"/>
    </root>
  </springProfile>
</configuration>
